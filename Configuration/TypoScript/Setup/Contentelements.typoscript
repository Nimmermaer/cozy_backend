tt_content {
  tx_cozybackend_doubletext < .text
  tx_cozybackend_doubletext {
    templateName = DoubleText
  }

  tx_cozybackend_slider < .image
  tx_cozybackend_slider {
    templateName = Slider
  }

  // Plugin Configuration
  // lib.contentElement is a FLUIDTEMPLATE, which ignores numeric sub-objects
  // like "20 = USER". The USER object is therefore passed in as a variable
  // and rendered inside the CozyBackendList template.
  cozy_backend_list =< lib.contentElement
  cozy_backend_list {
    templateName = CozyBackendList
    variables {
      elementList = USER
      elementList {
        userFunc = Mblunck\CozyBackend\UserFunc\ElementListUserFunc->listElements
        templateName = ListElements
      }
    }
  }
}

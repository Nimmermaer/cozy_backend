mod {
  wizards {
    newContentElement {
      wizardItems {
        default {
          header = TYPO3 Content Elemente
          elements {
            cozybackend_doubletext {
              description = LLL:EXT:cozy_backend/Resources/Private/Language/locallang.xlf:tt_content.cozybackend_doubletext.description
              iconIdentifier = content-text-columns
              title = LLL:EXT:cozy_backend/Resources/Private/Language/locallang.xlf:tt_content.cozybackend_doubletext
              tt_content_defValues {
                CType = cozybackend_doubletext
              }
            }
          }

          show := addToList(cozybackend_doubletext)
        }
      }
    }
  }
}

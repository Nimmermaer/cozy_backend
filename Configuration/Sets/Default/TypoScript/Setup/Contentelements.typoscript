tt_content {
  tx_cozybackend_doubletext < .text
  tx_cozybackend_doubletext {
    templateName = DoubleText
  }

  tx_cozybackend_slider < .image
  tx_cozybackend_slider {
    templateName = Slider
  }

  // Plugin Configuration
  cozybackend_list =< lib.contentElement
  cozybackend_list {
    20 = USER
    20 {
      userFunc = Mblunck\CozyBackend\UserFunc\ElementListUserFunc->listElements
      templateName = ListElements
    }

    templateName = Generic
  }
}

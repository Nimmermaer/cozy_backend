##############
#### PAGE ####
##############
page = PAGE
page {
    typeNum = 0
    shortcutIcon = EXT:cozy_backend/Resources/Public/Icons/favicon.ico

    10 = PAGEVIEW
    10 {
        paths {
            0 = EXT:cozy_backend/Resources/Private/PageView/
            1 = {$page.pageview.paths}
        }

        dataProcessing {
            10 = files
            10 {
                references.fieldName = media
            }

            20 = menu
            20 {
                levels = 2
                includeSpacer = 1
                as = mainnavigation
            }

            30 = page-content
        }
    }

    meta {
        viewport = {$page.meta.viewport}
        robots = {$page.meta.robots}
        apple-mobile-web-app-capable = {$page.meta.apple-mobile-web-app-capable}

        X-UA-Compatible = {$page.meta.compatible}
        X-UA-Compatible {
            attribute = http-equiv
        }
    }

    includeCSS {
        main = EXT:cozy_backend/Resources/Public/Assets/Css/main.css
    }

    includeJSFooter {
        main = EXT:cozy_backend/Resources/Public/Assets/JavaScript/main.js
        main {
            type = module
        }
    }

    headerData {
        1765049981229 = TEXT
        1765049981229 {
            value (
              <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
              <link rel="icon" type="image/png" sizes="16x16" href="/android-chrome-16x16.png">
              <link rel="icon" type="image/png" sizes="32x32" href="/android-chrome-32x32.png">
              <link rel="icon" type="image/png" sizes="48x48" href="/android-chrome-48x48.png"  />
              <link rel="icon" type="image/png" sizes="144x144" href="/android-chrome-144x144.png">
              <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png">
              <link rel="shortcut icon" href="/favicon.ico" />
              <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
              <link rel="mask-icon" href="{path:EXT:cozy_backend/Resources/Public/Icons/safari-pinned-tab.svg}" color="#5bbad5">
              <meta name="theme-color" content="{$pages.browser.color}">
              <link rel="manifest" href="/site.webmanifest" />
              <script src="/service-worker.js"></script>
            )
            insertData = 1
        }
    }
}

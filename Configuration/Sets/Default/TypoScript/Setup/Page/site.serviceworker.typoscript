site\.serviceworker = PAGE
site\.serviceworker {
  typeNum = 176510299
  config {
    additionalHeaders {
      20.header = Cache-Control: no-cache, no-store, must-revalidate
      10.header = Content-Type: text/javascript
    }

    disableAllHeaderCode = 1
    admPanel = 0
    debug = 0
  }

  10 = FLUIDTEMPLATE
  10 {
    file = EXT:cozy_backend/Resources/Public/Assets/Mobile/sw.js
  }
}

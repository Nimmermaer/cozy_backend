{
	"name": "mblunck/cozy-backend",
	"description": "Accompanying extension for the TYPO3 housekeeping presentation",
	"type": "typo3-cms-extension",
	"license": [
		"GPL-2.0-or-later"
	],
	"version": "1.0.0",
	"require": {
		"php": "^8.5",
		"typo3/cms-core": "*",
		"minishlink/web-push": "*",
		"chrome-php/chrome": "*",
		"praetorius/vite-asset-collector": "*"
	},
	"require-dev": {
		"helmich/typo3-typoscript-lint": "dev-master",
		"symfony/translation": "*"
	},
	"autoload": {
		"psr-4": {
			"Mblunck\\CozyBackend\\": "Classes/"
		}
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "cozy_backend"
		}
	}
}
